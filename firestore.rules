rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /events/{eventId} {
      // Anyone with the link can read an event (that's the whole point of
      // the app - no login required to view/join).
      allow read: true;

      // Anyone can create an event (guest or logged-in). If createdBy is
      // set, it must match the caller's own uid - no impersonating others.
      allow create: if request.resource.data.createdBy == null
        || request.resource.data.createdBy == request.auth.uid;

      // Only the signed-in creator can edit/delete the event itself.
      allow update, delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      match /participants/{participantId} {
        allow read: true;

        // Availability is a per-user action: it requires a signed-in
        // Google account, the participant doc id must be the caller's own
        // uid (no writing to someone else's slot), and the uid field
        // inside the document must match too.
        allow create, update: if request.auth != null
          && participantId == request.auth.uid
          && request.resource.data.uid == request.auth.uid;

        allow delete: if request.auth != null
          && (
            // Leave the event yourself...
            participantId == request.auth.uid
            // ...or, as the event's creator, remove a participant / cascade
            // delete every participant doc when deleting the event itself.
            || get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid
          );
      }
    }
  }
}
