rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isEventOwner(eventId) {
      return signedIn()
        && get(/databases/$(database)/documents/events/$(eventId))
          .data.createdBy == request.auth.uid;
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId))
          .data.ownerUid == request.auth.uid;
    }


    // =========================================================
    // EVENTS
    // =========================================================

    match /events/{eventId} {

      // Events are intentionally public.
      // Anyone with the event link can view it.
      allow get, list: if true;

      // Guests may create events.
      // Signed-in users may create events only for themselves.
      allow create: if
        request.resource.data.createdBy == null
        ||
        (
          signedIn()
          && request.resource.data.createdBy == request.auth.uid
        );

      // Only the original creator can modify/delete an event.
      // Also prevent changing ownership during an update.
      allow update: if
        signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if
        signedIn()
        && resource.data.createdBy == request.auth.uid;


      // -------------------------------------------------------
      // EVENT PARTICIPANTS
      // -------------------------------------------------------

      match /participants/{participantId} {

        // Public because the event itself is public and the app
        // displays participant availability on the event page.
        allow get, list: if true;

        // A user can only create/update their own participant doc.
        allow create, update: if
          signedIn()
          && participantId == request.auth.uid
          && request.resource.data.uid == request.auth.uid;

        // A user can remove themselves.
        // Event creator can also remove participants.
        allow delete: if
          signedIn()
          &&
          (
            participantId == request.auth.uid
            ||
            isEventOwner(eventId)
          );
      }
    }


    // =========================================================
    // COLLECTION-GROUP QUERY: PARTICIPANTS
    // =========================================================
    //
    // Required by MyEventsPage:
    //
    // collectionGroup(db, 'participants')
    //   .where('uid', '==', user.uid)
    //
    // Firebase requires a rule that matches the collection-group
    // collection itself.
    //

    match /{path=**}/participants/{participantId} {

      // IMPORTANT:
      // The query is restricted to the authenticated user's UID.
      // This prevents one logged-in user from querying another
      // user's participant records through this collection group.
      allow get, list: if
        signedIn()
        && resource.data.uid == request.auth.uid;
    }


    // =========================================================
    // GROUPS
    // =========================================================

    match /groups/{groupId} {

      // A signed-in user may open a group invite by ID.
      allow get: if signedIn();

      // Creating a group:
      // ownerUid must always be the authenticated user's UID.
      allow create: if
        signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // Only the current owner may modify/delete the group.
      // ownerUid cannot be changed through update.
      allow update: if
        signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if
        signedIn()
        && resource.data.ownerUid == request.auth.uid;


      // -------------------------------------------------------
      // GROUP MEMBERS
      // -------------------------------------------------------

      match /members/{memberId} {

        // The current UI needs to read the member list:
        // - GroupPage
        // - JoinGroupPage
        //
        // This means authenticated users can see membership of a
        // group if they know its ID.
        allow get, list: if signedIn();

        // A user can only create their own membership.
        // Also require that the group actually exists.
        allow create: if
          signedIn()
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && exists(
            /databases/$(database)/documents/groups/$(groupId)
          );

        // A user can leave.
        // The owner can remove other members.
        allow delete: if
          signedIn()
          &&
          (
            memberId == request.auth.uid
            ||
            isGroupOwner(groupId)
          );

        // There is currently no update operation in the UI.
        // Keeping this denied is safer.
      }
    }


    // =========================================================
    // COLLECTION-GROUP QUERY: MEMBERS
    // =========================================================
    //
    // Required by MyEventsPage:
    //
    // collectionGroup(db, 'members')
    //   .where('uid', '==', user.uid)
    //

    match /{path=**}/members/{memberId} {

      // Only allow collection-group queries for the user's
      // own membership documents.
      allow get, list: if
        signedIn()
        && resource.data.uid == request.auth.uid;
    }
  }
}